{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VamsiSudhakaran1/sedd_semantic_interface/blob/main/src/sema_sedd/report/schema_v1.json",
  "title": "SEDD semantic JSON report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version", "tool_version", "source_a", "source_b", "summary",
    "matches", "changes", "dependency_context", "unresolved", "diagnostics"
  ],
  "properties": {
    "report_schema_version": {"const": "1.0"},
    "tool_version": {"type": "string", "minLength": 1},
    "source_a": {"$ref": "#/$defs/source"},
    "source_b": {"$ref": "#/$defs/source"},
    "summary": {"$ref": "#/$defs/summary"},
    "matches": {"type": "array", "items": {"$ref": "#/$defs/match"}},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "dependency_context": {"type": "array", "items": {"$ref": "#/$defs/context_entry"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved_entry"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "revision"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "is_complete", "matched", "changed_entities", "added", "removed",
        "changes", "interface_changes", "documentation_changes", "unknown_changes",
        "unresolved", "diagnostics"
      ],
      "properties": {
        "is_complete": {"type": "boolean"},
        "matched": {"type": "integer", "minimum": 0},
        "changed_entities": {"type": "integer", "minimum": 0},
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "changes": {"type": "integer", "minimum": 0},
        "interface_changes": {"type": "integer", "minimum": 0},
        "documentation_changes": {"type": "integer", "minimum": 0},
        "unknown_changes": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "diagnostics": {"type": "integer", "minimum": 0}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "implementation_id", "name", "wkn"],
      "properties": {
        "key": {"type": ["string", "null"]},
        "implementation_id": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "wkn": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false,
             "required": ["value", "authority", "scope", "authority_status"],
             "properties": {
               "value": {"type": "string"},
               "authority": {"type": ["string", "null"]},
               "scope": {"type": ["string", "null"]},
               "authority_status": {"enum": ["unverified", "verified"]}
             }}
          ]
        }
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_type", "source_a", "source_b"],
      "properties": {
        "entity_type": {
          "enum": [
            "status_variable", "data_variable", "equipment_constant", "collection_event",
            "alarm", "remote_command", "remote_command_parameter", "supported_message",
            "variable_format", "default_report", "event_report_link", "standard_reference",
            "equipment_metadata", "equipment_interface"
          ]
        },
        "source_a": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "source_b": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]}
      }
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "strategy", "confidence", "evidence"],
      "properties": {
        "subject": {"$ref": "#/$defs/subject"},
        "strategy": {
          "enum": ["NATIVE_ID", "WELL_KNOWN_NAME", "COMMAND_NAME", "PARAMETER_NAME",
                   "FORMAT_NAME", "STANDARD_DESIGNATION", "EVENT_IDENTITY", "STREAM_FUNCTION"]
        },
        "confidence": {"enum": ["CORROBORATED", "VERIFIED_WKN", "EXACT_IDENTITY"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/matching_evidence"}}
      }
    },
    "matching_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "entity_type", "identity", "source_a_keys", "source_b_keys"],
      "properties": {
        "strategy": {"type": "string"},
        "entity_type": {"type": "string"},
        "identity": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_a_keys": {"type": "array", "items": {"type": "string"}},
        "source_b_keys": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relationship_delta": {
      "type": "object", "additionalProperties": false,
      "required": ["added", "removed", "order_changed", "presence_changed"],
      "properties": {
        "added": {"type": "array"},
        "removed": {"type": "array"},
        "order_changed": {"type": "boolean"},
        "presence_changed": {"type": "boolean"}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": [
        "change_id", "category", "scope", "subject", "field", "before", "after",
        "relationship_delta"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^(SV|DV|EC|CE|AL|RC|RCP|SM|VF|DR|ERL|STD|EQ|EI)_[A-Z][A-Z0-9_]*$"
        },
        "category": {"enum": ["INTERFACE_CHANGE", "DOCUMENTATION_CHANGE", "UNKNOWN_CHANGE"]},
        "scope": {"enum": ["entity", "property", "relationship"]},
        "subject": {"$ref": "#/$defs/subject"},
        "field": {"type": ["string", "null"]},
        "before": {},
        "after": {},
        "relationship_delta": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/relationship_delta"}]
        }
      }
    },
    "context_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "source_a", "source_b"],
      "properties": {
        "subject": {"$ref": "#/$defs/subject"},
        "source_a": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]},
        "source_b": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": [
        "subject_key", "subject_type", "dependencies",
        "excluded_unresolved_graph_relationships", "statements"
      ],
      "properties": {
        "subject_key": {"type": ["string", "null"]},
        "subject_type": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "object"}},
        "excluded_unresolved_graph_relationships": {"type": "integer", "minimum": 0},
        "statements": {"type": "array", "items": {"type": "string"}}
      }
    },
    "unresolved_entry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "issue_code", "source", "entity_type", "entity_key", "field", "detail",
        "identity_ambiguity"
      ],
      "properties": {
        "issue_code": {
          "enum": ["AMBIGUOUS_IDENTITY", "INSUFFICIENT_IDENTITY", "UNRESOLVED_REFERENCE",
                   "UNCERTAIN_TARGET_IDENTITY", "UNKNOWN_CONTENT"]
        },
        "source": {"enum": ["a", "b"]},
        "entity_type": {"type": ["string", "null"]},
        "entity_key": {"type": ["string", "null"]},
        "field": {"type": ["string", "null"]},
        "detail": {"type": "string"},
        "identity_ambiguity": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity_ambiguity"}]
        }
      }
    },
    "identity_ambiguity": {
      "type": "object", "additionalProperties": false,
      "required": ["reasons", "evidence", "source_a_keys", "source_b_keys"],
      "properties": {
        "reasons": {"type": "array", "minItems": 1,
                    "items": {"enum": ["IDENTITY_COLLISION", "CONFLICTING_SIGNALS"]}},
        "evidence": {"type": "array", "minItems": 1,
                     "items": {"$ref": "#/$defs/matching_evidence"}},
        "source_a_keys": {"type": "array", "items": {"type": "string"}},
        "source_b_keys": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "code", "severity", "message", "provenance"],
      "properties": {
        "source": {"enum": ["a", "b"]},
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string"},
        "provenance": {"oneOf": [{"type": "null"}, {"type": "object"}]}
      }
    }
  }
}
